# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# AlphaMissense data / model outputs (often large)
data/
*.tsv.gz
# Local VEP cache + hg38 AlphaMissense table (multi-GB; keep out of git)
/vep_cache/
AlphaMissense_hg38.tsv.bgz
AlphaMissense_hg38.tsv.bgz.tbi
*.fasta
*.fa
msa_output/

# AlphaMissense source repo (cloned to WSL native FS at ~/alphamissense and
# previously symlinked here as ./alphamissense -- WSL symlinks on /mnt/c are
# unreadable to Windows-native git, hence this hard ignore).
/alphamissense
/alphamissense/

# Temporary helper scripts written by tools / agents.
.tmp_*.sh

# Captured stdout / log files from .scratch/ runs (reproducible from the
# corresponding scripts; not worth tracking).
.scratch/*.out
.scratch/*.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
